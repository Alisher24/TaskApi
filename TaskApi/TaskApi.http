@TaskApi_HostAddress = http://localhost:5126
@taskId = 00000000-0000-0000-0000-000000000000

### Create a task (default priority: Medium)
POST {{TaskApi_HostAddress}}/tasks
Content-Type: application/json

{
  "title": "Implement the task API"
}

### Create a task with a priority
POST {{TaskApi_HostAddress}}/tasks
Content-Type: application/json

{
  "title": "Check validation",
  "priority": "High"
}

### Get all tasks
GET {{TaskApi_HostAddress}}/tasks
Accept: application/json

### Complete a task: 200 - set taskId to an id from the POST or GET response
PUT {{TaskApi_HostAddress}}/tasks/{{taskId}}/complete
Accept: application/json

### Complete the same task again: 409
PUT {{TaskApi_HostAddress}}/tasks/{{taskId}}/complete

### Delete a task
DELETE {{TaskApi_HostAddress}}/tasks/{{taskId}}

### Complete the deleted task: 404
PUT {{TaskApi_HostAddress}}/tasks/{{taskId}}/complete

### Validation error: 400
POST {{TaskApi_HostAddress}}/tasks
Content-Type: application/json

{
  "title": "   ",
  "priority": 3
}

### Invalid Guid: 400
DELETE {{TaskApi_HostAddress}}/tasks/not-a-guid

### Invalid Guid when completing: 400
PUT {{TaskApi_HostAddress}}/tasks/not-a-guid/complete
